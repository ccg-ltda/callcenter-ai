# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Secreto aleatorio de 32+ caracteres para callbacks TeXML heredados.
TELNYX_WEBHOOK_SECRET=
# ID de la aplicacion TeXML usada para llamadas salientes con agentes de IA.
# Si se omite o ya no existe, la aplicacion la descubre o crea automaticamente.
TELNYX_TEXML_APPLICATION_ID=
# Compatibilidad heredada. Prefiere TELNYX_TEXML_APPLICATION_ID.
TELNYX_CONNECTION_ID=
TELNYX_ASSISTANT_MODEL=anthropic/claude-haiku-4-5
TELNYX_TEXML_VOICE_URL=
TELNYX_WEBHOOK_URL=

# Google Calendar via Apps Script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# OpenAI summaries
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5-mini

# Use local mock integrations when true
NEXT_PUBLIC_USE_MOCK_SERVICES=true

# Acceso privado al panel (contraseña de 12+ y secreto aleatorio de 32+ caracteres)
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
# Opcional: clave dedicada de 32+ caracteres para cifrar refresh tokens.
# Si se omite, se deriva una clave separada desde AUTH_SECRET.
TOKEN_ENCRYPTION_KEY=
